# Copy this file to .env.test and fill in the values.
# .env.test is gitignored. Use a THROWAWAY dev project only: the test suite
# creates and deletes users, and the service-role key bypasses all RLS.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → Project API keys
# (labelled "anon public" / "publishable" on newer projects)
SUPABASE_ANON_KEY=

# Same page, "service_role secret" / "secret". Server-side only, never in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with the database password you set at project
# creation. Percent-encode any special characters in it.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Just the ref, e.g. abcdefghijklmnopqrst — the subdomain of your project URL.
SUPABASE_PROJECT_REF=

# https://supabase.com/dashboard/account/tokens → Generate new token
# Needed to deploy Edge Functions from the CLI without an interactive login.
SUPABASE_ACCESS_TOKEN=
