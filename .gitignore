# Secrets and local Supabase state.
# Deny every .env variant and re-admit only the committed templates, so a new
# file such as .env or .env.production cannot be added by accident.
.env*
!.env*.example
supabase/.temp/
supabase/.branches/
shots/

# Wrangler local secrets (same reasoning as .env* above).
.dev.vars
.dev.vars.*
.wrangler/
