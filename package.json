{
  "name": "nc-spark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:worker": "npm run build && npx wrangler deploy",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.js",
    "db:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-docker.ps1",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "node ./scripts/write-local-env.mjs",
    "db:status": "supabase status",
    "db:seed-catalog": "node ./scripts/seed-catalog.mjs",
    "verify:m3": "node ./scripts/verify-m3.mjs",
    "db:seed-quizzes": "node ./scripts/seed-quizzes.mjs",
    "verify:m4": "node ./scripts/verify-m4.mjs",
    "db:seed-review": "node ./scripts/seed-review-users.mjs",
    "verify:gate": "node ./scripts/verify-access-gate.mjs",
    "deploy": "npm run build && wrangler deploy",
    "worker:dev": "wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "dompurify": "^3.4.14",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
