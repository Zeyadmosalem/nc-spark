{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nc-spark-gate",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // The app is a single-page router: /trainee/achievements is not a file in
    // dist, so with "none" the assets binding 404s and every deep link and
    // every page refresh breaks for a signed-in user. Only "/" worked.
    "not_found_handling": "single-page-application"
  }
}