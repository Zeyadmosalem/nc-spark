{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nc-spark-gate",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}